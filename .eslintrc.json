{
  "env": {
    "browser": true,
    "es2021": true,
    "webextensions": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off"
  },
  "overrides": [
    {
      "files": [
        "scripts/**/*.js",
        "test/**/*.js",
        "lib/**/*.js",
        "api/**/*.js"
      ],
      "env": {
        "node": true,
        "browser": false
      }
    }
  ]
}
