{
  "name": "botlens",
  "version": "1.4.1",
  "description": "Analyze if a website is readable by AI",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "build": "bash scripts/build.sh",
    "check:faq": "node scripts/check-faq-jsonld.js",
    "fix:faq": "node scripts/check-faq-jsonld.js --write"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.14.0"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "linkedom": "0.18.14",
    "undici": "8.12.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
